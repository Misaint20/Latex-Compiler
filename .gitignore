# ═══════ Build trees (CMake preset name first level) ═══════
/build/
# Packaging output (DMG/MSI/ZIP)
/dist/

# ═══════ Frontend (Vite/pnpm) ═══════
/frontend/node_modules/
/frontend/dist/
# Generated frontend assets, embedded/copied by the build (never edit by hand)
/resources/frontend/
# TypeScript incremental-build state (regenerated by `tsc -b`)
/frontend/*.tsbuildinfo
/frontend/node_modules/.tmp/

# ═══════ System junk ═══════
.DS_Store
.DS_Store?

# ═══════ IDE (keep shared config, ignore personal) ═══════
/.vscode/
/.idea/
*.swp
*~

# ═══════ This tool's workspace state ═══════
/.freebuff/

# ═══════ Diagram stamp: identity of the toolchain that produced the
# current artifacts. It is per-machine state (paths + mtimes) and a
# mismatch only triggers one full rebuild, so it does not belong in git.
.latexcompiler-diagram-stamp
